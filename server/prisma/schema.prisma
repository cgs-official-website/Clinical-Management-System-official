datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. TENANCY & AUTHENTICATION
// -------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REJECTED
  DECOMMISSIONED
}

model Tenant {
  id              String          @id @default(uuid())
  name            String
  subdomain       String          @unique
  domain          String?
  plan            String          @default("Professional")
  status          TenantStatus    @default(ACTIVE)
  region          String          @default("North America (East)")
  contactEmail    String?
  rejectionReason String?         @map("rejection_reason")
  clinicCategoryId String?        @map("clinic_category_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  auto_bill_specialty Boolean     @default(false)
  clinicCategory  ClinicCategory? @relation(fields: [clinicCategoryId], references: [id], onDelete: SetNull)
  users           User[]
  roles           Role[]
  departments     Department[]
  patients        Patient[]
  appointments    Appointment[]
  invoices        Invoice[]
  inventory       InventoryItem[]
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]
  roleTemplates   RoleTemplate[]
  tenantModules   TenantModule[]
  ecgRecords      EcgRecord[]
  echoReports     EchoReport[]
  cathLabProcedures CathLabProcedure[]
  cardiacRiskAssessments CardiacRiskAssessment[]
  toothRecords    ToothRecord[]
  treatmentPlans  TreatmentPlan[]
  xrayRecords     XrayRecord[]
  labOrders       LabOrder[]
  physioTreatmentPlans  PhysioTreatmentPlan[]
  physioExercises       PhysioExercise[]
  physioProgressNotes   PhysioProgressNote[]

  @@index([clinicCategoryId])
  @@map("tenants")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum UserType {
  SUPERADMIN
  ADMIN
  STAFF
}

model User {
  id            String     @id @default(uuid())
  tenantId      String?    @map("tenant_id")
  email         String     @unique
  passwordHash  String     @map("password_hash")
  fullName      String     @map("full_name")
  phone         String?
  avatar        String?
  status        UserStatus @default(ACTIVE)
  userType      UserType   @default(STAFF) @map("user_type")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  userRoles     UserRole[]
  staffProfile  StaffProfile?
  auditLogs     AuditLog[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  userAgent   String?   @map("user_agent")
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// -------------------------------------------------------------
// 2. DYNAMIC RBAC ENGINE (Data-Driven, Zero Hardcoded Roles/Perms)
// -------------------------------------------------------------

model Module {
  id          String       @id @default(uuid())
  key         String       @unique // e.g. 'patients', 'appointments', 'billing'
  name        String
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")

  permissions     Permission[]
  categoryModules ClinicCategoryModule[]
  tenantModules   TenantModule[]

  @@map("modules")
}

model PermissionAction {
  id          String       @id @default(uuid())
  key         String       @unique // e.g. 'view', 'create', 'edit', 'delete', 'export', 'approve'
  name        String

  permissions Permission[]

  @@map("permission_actions")
}

model Permission {
  id          String            @id @default(uuid())
  moduleId    String            @map("module_id")
  actionId    String            @map("action_id")
  key         String            @unique // e.g. 'patients.view', 'appointments.create'
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")

  module      Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  action      PermissionAction  @relation(fields: [actionId], references: [id], onDelete: Cascade)
  rolePerms   RolePermission[]

  @@unique([moduleId, actionId])
  @@index([key])
  @@map("permissions")
}

model Role {
  id           String           @id @default(uuid())
  tenantId     String?          @map("tenant_id")
  name         String
  description  String?
  isSystemRole Boolean          @default(false) @map("is_system_role")
  createdBy    String?          @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant       Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePerms    RolePermission[]
  userRoles    UserRole[]

  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  grantedAt    DateTime   @default(now()) @map("granted_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedBy String?  @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RoleTemplate {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  keyword     String
  module      String
  action      String
  isWildcard  Boolean  @default(false) @map("is_wildcard")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyword])
  @@map("role_templates")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  actorUserId String?  @map("actor_user_id")
  action      String   // e.g. 'CREATE_ROLE', 'UPDATE_PERMISSIONS', 'ASSIGN_STAFF'
  entityType  String   @map("entity_type") // e.g. 'role', 'user', 'patient'
  entityId    String?  @map("entity_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// 3. CLINICAL DOMAIN MODELS
// -------------------------------------------------------------

model Department {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  name        String
  createdAt   DateTime       @default(now()) @map("created_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff       StaffProfile[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("departments")
}

model StaffProfile {
  id           String        @id @default(uuid())
  userId       String        @unique @map("user_id")
  departmentId String?       @map("department_id")
  specialty    String?
  licenseNo    String?       @map("license_no")
  createdAt    DateTime      @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@map("staff_profiles")
}

model Patient {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  mrn            String        @unique // Medical Record Number
  fullName       String        @map("full_name")
  dob            DateTime
  gender         String
  bloodGroup     String?       @map("blood_group")
  phone          String
  email          String?
  address        String?
  allergies      Json?         @default("[]")
  chronicConditions Json?      @default("[]") @map("chronic_conditions")
  medicalHistory Json?         @default("{}") @map("medical_history")
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  prescriptions  Prescription[]
  invoices       Invoice[]
  ecgRecords     EcgRecord[]
  echoReports    EchoReport[]
  cathLabProcedures CathLabProcedure[]
  cardiacRiskAssessments CardiacRiskAssessment[]
  toothRecords   ToothRecord[]
  treatmentPlans TreatmentPlan[]
  xrayRecords    XrayRecord[]
  labOrders      LabOrder[]
  physioTreatmentPlans PhysioTreatmentPlan[]
  physioExercises      PhysioExercise[]
  physioProgressNotes  PhysioProgressNote[]

  @@index([tenantId])
  @@index([mrn])
  @@index([fullName])
  @@map("patients")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  patientId      String            @map("patient_id")
  staffId        String?           @map("staff_id")
  departmentId   String?           @map("department_id")
  scheduledAt    DateTime          @map("scheduled_at")
  durationMinutes Int              @default(30) @map("duration_minutes")
  status         AppointmentStatus @default(SCHEDULED)
  type           String            @default("In-Person Consultation")
  room           String?
  reason         String?
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor         StaffProfile?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  prescriptions  Prescription[]
  invoices       Invoice[]

  @@index([tenantId])
  @@index([patientId])
  @@index([staffId])
  @@index([scheduledAt])
  @@map("appointments")
}

model Prescription {
  id            String       @id @default(uuid())
  appointmentId String?      @map("appointment_id")
  patientId     String       @map("patient_id")
  prescribedBy  String       @map("prescribed_by") // Doctor name or ID
  diagnosis     String
  medications   Json         // Array of { drug, dosage, frequency, duration, refills }
  notes         String?
  status        String       @default("Active")
  createdAt     DateTime     @default(now()) @map("created_at")

  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([appointmentId])
  @@map("prescriptions")
}

enum InvoiceStatus {
  PENDING
  PAID
  VOID
}

model Invoice {
  id                    String        @id @default(uuid())
  tenantId              String        @map("tenant_id")
  patientId             String        @map("patient_id")
  appointmentId         String?       @map("appointment_id")
  invoiceNumber         String        @unique @map("invoice_number")
  amount                Float
  insuranceCoverage     Float         @default(0) @map("insurance_coverage")
  patientResponsibility Float         @default(0) @map("patient_responsibility")
  status                InvoiceStatus @default(PENDING)
  paymentMethod         String?       @map("payment_method")
  dueDate               DateTime?     @map("due_date")
  createdAt             DateTime      @default(now()) @map("created_at")

  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient               Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment           Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items                 InvoiceItem[]

  @@index([tenantId])
  @@index([patientId])
  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  description String
  code        String?  // CPT or local billing code
  fee         Float

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InventoryItem {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  itemCode            String   @map("item_code")
  name                String
  category            String
  stockQuantity       Int      @default(0) @map("stock_quantity")
  unit                String   @default("Units")
  minReorderThreshold Int      @default(50) @map("min_reorder_threshold")
  batchNumber         String?  @map("batch_number")
  expiryDate          DateTime? @map("expiry_date")
  unitCost            Float    @default(0) @map("unit_cost")
  sellingPrice        Float    @default(0) @map("selling_price")
  status              String   @default("Optimal")
  
  // India-compliant Pharmacy Inventory Extension Fields
  brandName            String?   @map("brand_name")
  dosageForm           String?   @map("dosage_form")
  strength             String?   @map("strength")
  manufacturer         String?   @map("manufacturer")
  mfgDate              DateTime? @map("mfg_date")
  schedule             String?   @default("OTC") @map("schedule") // OTC, H, H1, X, G
  hsnCode              String?   @map("hsn_code")
  packSize             String?   @map("pack_size")
  gstRate              Float?    @default(12) @map("gst_rate")
  supplierName         String?   @map("supplier_name")
  storageCondition     String?   @map("storage_condition")
  prescriptionRequired Boolean   @default(false) @map("prescription_required")
  mfrLicenseNumber     String?   @map("mfr_license_number")
  dpcoCeilingPrice     Float?    @map("dpco_ceiling_price")
  importBatchId        String?   @map("import_batch_id")
  importedBy           String?   @map("imported_by")
  importedAt           DateTime? @map("imported_at")
  
  createdAt           DateTime @default(now()) @map("created_at")

  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements       StockMovement[]

  @@unique([tenantId, itemCode])
  @@index([tenantId])
  @@index([tenantId, batchNumber])
  @@map("inventory_items")
}

model StockMovement {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  inventoryItemId String   @map("inventory_item_id")
  type            String   @default("Bulk Import") // "Bulk Import", "Adjustment", "Dispensed"
  quantityIn      Int      @default(0) @map("quantity_in")
  quantityOut     Int      @default(0) @map("quantity_out")
  balance         Int      @default(0)
  batchNumber     String?  @map("batch_number")
  handledBy       String?  @map("handled_by")
  importBatchId   String?  @map("import_batch_id")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([importBatchId])
  @@map("stock_movements")
}

// -------------------------------------------------------------
// 4. CMS & MARKETING SITE DOMAIN
// -------------------------------------------------------------

model PublicSiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  content   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("public_site_content")
}

model NewsletterSubscription {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("newsletter_subscriptions")
}

model DemoRequest {
  id          String   @id @default(uuid())
  name        String
  email       String
  clinicName  String?  @map("clinic_name")
  phone       String?
  status      String   @default("PENDING")
  requestedAt DateTime @default(now()) @map("requested_at")

  @@map("demo_requests")
}

// -------------------------------------------------------------
// 5. CLINIC CATEGORIES & CATEGORY ROLE TEMPLATES
// -------------------------------------------------------------

model ClinicCategory {
  id          String                         @id @default(uuid())
  name        String                         @unique
  description String?
  isActive    Boolean                        @default(true) @map("is_active")
  createdAt   DateTime                       @default(now()) @map("created_at")
  updatedAt   DateTime                       @updatedAt @map("updated_at")

  tenants         Tenant[]
  roleTemplates   ClinicCategoryRoleTemplate[]
  categoryModules ClinicCategoryModule[]

  @@map("clinic_categories")
}

model ClinicCategoryRoleTemplate {
  id               String         @id @default(uuid())
  clinicCategoryId String         @map("clinic_category_id")
  roleName         String         @map("role_name")
  module           String
  action           String
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  clinicCategory   ClinicCategory @relation(fields: [clinicCategoryId], references: [id], onDelete: Cascade)

  @@index([clinicCategoryId])
  @@index([roleName])
  @@map("clinic_category_role_templates")
}

model ClinicCategoryModule {
  id               String         @id @default(uuid())
  clinicCategoryId String         @map("clinic_category_id")
  moduleId         String         @map("module_id")
  displayOrder     Int            @default(0) @map("display_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  clinicCategory   ClinicCategory @relation(fields: [clinicCategoryId], references: [id], onDelete: Cascade)
  module           Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([clinicCategoryId, moduleId])
  @@index([clinicCategoryId])
  @@index([moduleId])
  @@map("clinic_category_modules")
}

model TenantModule {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  moduleId  String   @map("module_id")
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([moduleId])
  @@map("tenant_modules")
}

// -------------------------------------------------------------
// 7. NOTIFICATIONS SYSTEM
// -------------------------------------------------------------

model Notification {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  type        String    @default("CLINIC_REGISTRATION_PENDING")
  title       String
  message     String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  data        Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isRead])
  @@index([entityId])
  @@map("notifications")
}




// -------------------------------------------------------------
// CARDIOLOGY CATEGORY CLINICAL RECORDS
// -------------------------------------------------------------

model EcgRecord {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  patientId     String    @map("patient_id")
  ecgNumber     String    @map("ecg_number")
  acquiredAt    DateTime  @default(now()) @map("acquired_at")
  rhythm        String
  heartRate     Int       @map("heart_rate")
  prInterval    Int?      @map("pr_interval")
  qrsDuration   Int?      @map("qrs_duration")
  qtcInterval   Int?      @map("qtc_interval")
  axis          String?
  stSegment     String?   @map("st_segment")
  leadFindings  Json      @default("[]") @map("lead_findings")
  priority      String    @default("ROUTINE")
  status        String    @default("REQUIRES_REVIEW")
  cardiologist  String?
  signedOffAt   DateTime? @map("signed_off_at")
  signedOffBy   String?   @map("signed_off_by")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ecgNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([acquiredAt])
  @@map("ecg_records")
}

model EchoReport {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  patientId     String    @map("patient_id")
  reportNumber  String    @map("report_number")
  studyDate     DateTime  @map("study_date")
  modality      String    @default("Transthoracic Echocardiogram (TTE)")
  indication    String?
  sonographer   String?
  cardiologist  String?
  efPercent     Int       @map("ef_percent")
  lvedd         Float?
  lvesd         Float?
  ivsd          Float?
  pwd           Float?
  laVolumeIndex Float?    @map("la_volume_index")
  valves        Json      @default("[]")
  wallMotion    String?   @map("wall_motion")
  conclusions   Json      @default("[]")
  status        String    @default("DRAFT")
  finalizedAt   DateTime? @map("finalized_at")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reportNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([studyDate])
  @@map("echo_reports")
}

model CathLabProcedure {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  patientId         String    @map("patient_id")
  caseNumber        String    @map("case_number")
  lab               String
  procedure         String
  scheduledStart    DateTime  @map("scheduled_start")
  scheduledEnd      DateTime  @map("scheduled_end")
  interventionalist String?
  scrubNurse        String?   @map("scrub_nurse")
  radiologicTech    String?   @map("radiologic_tech")
  accessSite        String?   @map("access_site")
  contrastAgent     String?   @map("contrast_agent")
  fluoroscopyMinutes Float?   @map("fluoroscopy_minutes")
  urgency           String    @default("ELECTIVE")
  status            String    @default("SCHEDULED")
  intraOpNotes      String?   @map("intra_op_notes")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, caseNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([scheduledStart])
  @@map("cath_lab_procedures")
}

model CardiacRiskAssessment {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  patientId        String   @map("patient_id")
  assessedAt       DateTime @default(now()) @map("assessed_at")
  age              Int
  sex              String
  race             String   @default("OTHER")
  sbp              Int
  totalCholesterol Int      @map("total_cholesterol")
  hdl              Int
  ldl              Int?
  diabetes         Boolean  @default(false)
  smoker           Boolean  @default(false)
  onBpTreatment    Boolean  @default(false) @map("on_bp_treatment")
  onStatin         Boolean  @default(false) @map("on_statin")
  onAspirin        Boolean  @default(false) @map("on_aspirin")
  cacScore         Int?     @map("cac_score")
  scorePercent     Float    @map("score_percent")
  riskCategory     String   @map("risk_category")
  recommendation   String?
  physician        String?
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([assessedAt])
  @@map("cardiac_risk_assessments")
}



// =========================================================================
// DENTAL CARE MODULES
// =========================================================================

// One current record per tooth (Universal numbering 1-32) per patient
model ToothRecord {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  patientId     String   @map("patient_id")
  toothNo       Int      @map("tooth_no")
  status        String   @default("HEALTHY") // HEALTHY | CARIES | RESTORED | CROWN | ROOT_CANAL | IMPLANT | MISSING
  surfaces      Json     @default("[]")      // ["M","O","D","B","L"]
  notes         String?
  probingDepths Json?    @map("probing_depths") // { DB, B, MB, DL, L, ML } in mm
  updatedBy     String?  @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, toothNo])
  @@index([tenantId])
  @@index([patientId])
  @@map("tooth_records")
}

model TreatmentPlan {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  patientId  String   @map("patient_id")
  name       String
  status     String   @default("ACTIVE") // DRAFT | ACTIVE | COMPLETED | CANCELLED
  invoiceId  String?  @map("invoice_id")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items      TreatmentPlanItem[]

  @@index([tenantId])
  @@index([patientId])
  @@map("treatment_plans")
}

model TreatmentPlanItem {
  id                String   @id @default(uuid())
  planId            String   @map("plan_id")
  phase             String   @default("Phase 1")
  code              String?  // procedure / billing code
  description       String
  toothNo           String?  @map("tooth_no") // "14", "14 (MO)", "All"
  fee               Float    @default(0)
  insuranceCoverage Float    @default(0) @map("insurance_coverage")
  status            String   @default("PLANNED") // PLANNED | ACCEPTED | IN_PROGRESS | COMPLETED
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")

  plan              TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("treatment_plan_items")
}

model XrayRecord {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  patientId   String   @map("patient_id")
  scanType    String   @map("scan_type") // Panoramic (OPG) | Periapical (IOPA) | Bitewing | CBCT | Cephalometric
  region      String?
  toothNo     String?  @map("tooth_no")
  takenAt     DateTime @default(now()) @map("taken_at")
  radiologist String?
  findings    String?
  status      String   @default("PENDING") // PENDING | VERIFIED
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@map("xray_records")
}

model LabOrder {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  patientId String    @map("patient_id")
  orderNo   String    @map("order_no")
  lab       String
  workType  String    @map("work_type") // Crown | Bridge | Denture | Veneer | Night Guard ...
  material  String?
  toothNo   String?   @map("tooth_no")
  shade     String?
  dueDate   DateTime? @map("due_date")
  status    String    @default("DRAFT") // DRAFT | SENT | IN_PROGRESS | RECEIVED | FITTED | CANCELLED
  notes     String?
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderNo])
  @@index([tenantId])
  @@index([patientId])
  @@map("lab_orders")
}

// =========================================================================
// PHYSIOTHERAPY MODULES
// (tables are prefixed physio_ so they never clash with dental treatment_plans)
// =========================================================================

// Treatment / Session Plans (e.g. "Rotator Cuff Post-Surgical Rehab")
model PhysioTreatmentPlan {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  patientId         String   @map("patient_id")
  title             String
  status            String   @default("ACTIVE") // DRAFT | ACTIVE | IN_PROGRESS | COMPLETED | CANCELLED
  totalSessions     Int      @default(0) @map("total_sessions")
  sessionsCompleted Int      @default(0) @map("sessions_completed")
  startDate         DateTime? @map("start_date")
  therapist         String?
  // [{ name, sessions, status, modalities: [] }]
  phases            Json     @default("[]")
  notes             String?
  createdBy         String?  @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@map("physio_treatment_plans")
}

// Exercise Program Tracker (home exercise program per patient)
model PhysioExercise {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  patientId      String   @map("patient_id")
  name           String
  target         String?  // target muscle / joint
  sets           Int      @default(3)
  reps           String?  // "15 reps (5s hold)"
  resistance     String?
  frequency      String?  // "2x Daily"
  difficulty     String   @default("Moderate") // Easy | Moderate | Hard
  completedToday Boolean  @default(false) @map("completed_today")
  adherenceRate  Int      @default(0) @map("adherence_rate") // percent 0-100
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@map("physio_exercises")
}

// Progress / Recovery Notes (SOAP + ROM + pain score)
model PhysioProgressNote {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  patientId     String   @map("patient_id")
  sessionNumber Int      @default(1) @map("session_number")
  noteDate      DateTime @default(now()) @map("note_date")
  therapist     String?
  subjective    String?
  objective     String?
  assessment    String?
  plan          String?
  // [{ joint, value, change }]
  romMetrics    Json     @default("[]") @map("rom_metrics")
  painScore     Int?     @map("pain_score") // VAS 0-10
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([noteDate])
  @@map("physio_progress_notes")
}
